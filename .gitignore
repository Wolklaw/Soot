# the browser engine: downloaded from Mozilla by setup.ps1, never committed
engine/
# your own data: history, cookies, vault, add-ons
profile/
# rewritten engine text, regenerated by Soot after each engine update
app/l10n-auto/
# the Android app's signing key and its password: private, never committed
phone/soot.keystore
phone/soot.keystore.password.txt
phone/build/
phone/.gradle/
phone/local.properties
phone/*.idsig
# built files: they ship in the release, not in the source
Soot.exe
phone/Soot.apk
*.zip
# not part of the browser
own-engine/
.claude/
