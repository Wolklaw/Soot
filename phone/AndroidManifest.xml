<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:label="Soot"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Soot"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- the browser -->
        <activity
            android:name=".BrowserActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
        <!-- the vault: pairing, sync, logins, codes, notes. Opened from the browser, and by autofill to unlock. -->
        <activity android:name=".VaultActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".SootAutofill"
            android:label="Soot"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill" />
        </service>
    </application>
</manifest>
